<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS: redirect any plain-HTTP request to the secure URL.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # Next.js static export fetches RSC payloads like /en/events/index.txt.
  # Never treat those filenames as CMS slugs (that produced ?slug=index.txt).
  RewriteRule \.(txt|html|js|css|json|map|xml|ico|png|jpe?g|gif|svg|webp|woff2?)$ - [L,NC]
  RewriteRule ^_next/ - [L]
  RewriteRule ^og\.php$ - [L]

  # Social crawlers do not run JavaScript. Serve OG title/image from og.php
  # instead of the static detail shell (otherwise Facebook shows a blank card).
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Discordbot|Pinterest|vkShare) [NC]
  RewriteRule ^(en|ar)/speakers/detail/?$ /og.php?type=speaker&locale=$1 [L,QSA]
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Discordbot|Pinterest|vkShare) [NC]
  RewriteRule ^(en|ar)/speakers/([^/.]+)/?$ /og.php?type=speaker&locale=$1&slug=$2 [L]

  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Discordbot|Pinterest|vkShare) [NC]
  RewriteRule ^(en|ar)/team/detail/?$ /og.php?type=team&locale=$1 [L,QSA]
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Discordbot|Pinterest|vkShare) [NC]
  RewriteRule ^(en|ar)/team/([^/.]+)/?$ /og.php?type=team&locale=$1&id=$2 [L]

  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Discordbot|Pinterest|vkShare) [NC]
  RewriteRule ^(en|ar)/organizers/detail/?$ /og.php?type=organizer&locale=$1 [L,QSA]
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Discordbot|Pinterest|vkShare) [NC]
  RewriteRule ^(en|ar)/organizers/([^/.]+)/?$ /og.php?type=organizer&locale=$1&id=$2 [L]

  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Discordbot|Pinterest|vkShare) [NC]
  RewriteRule ^(en|ar)/articles/detail/?$ /og.php?type=article&locale=$1 [L,QSA]
  RewriteCond %{HTTP_USER_AGENT} (facebookexternalhit|Facebot|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Discordbot|Pinterest|vkShare) [NC]
  RewriteRule ^(en|ar)/articles/([^/.]+)/?$ /og.php?type=article&locale=$1&slug=$2 [L]

  # CMS detail pages are one statically exported shell per type.
  # Pretty URLs cannot exist as real folders with output: "export".
  # External redirect so the browser URL matches the HTML Next exported.

  RewriteRule ^(en|ar)/speakers/detail/?$ - [L]
  RewriteRule ^(en|ar)/speakers/([^/.]+)/?$ /$1/speakers/detail/?slug=$2 [R=302,L,QSA]

  RewriteRule ^(en|ar)/events/detail/?$ - [L]
  RewriteRule ^(en|ar)/events/([^/.]+)/?$ /$1/events/detail/?slug=$2 [R=302,L,QSA]

  RewriteRule ^(en|ar)/organizers/detail/?$ - [L]
  RewriteRule ^(en|ar)/organizers/([^/.]+)/?$ /$1/organizers/detail/?id=$2 [R=302,L,QSA]

  RewriteRule ^(en|ar)/team/detail/?$ - [L]
  RewriteRule ^(en|ar)/team/([^/.]+)/?$ /$1/team/detail/?id=$2 [R=302,L,QSA]

  RewriteRule ^(en|ar)/partner/detail/?$ - [L]
  RewriteRule ^(en|ar)/partner/([^/.]+)/?$ /$1/partner/detail/?slug=$2 [R=302,L,QSA]

  RewriteRule ^(en|ar)/articles/detail/?$ - [L]
  RewriteRule ^(en|ar)/articles/([^/.]+)/?$ /$1/articles/detail/?slug=$2 [R=302,L,QSA]
</IfModule>

# ───────────────────────────────────────────────────────────────
# Security headers (TEDx technical audit — Oct 2026)
# Applied to every response served by Apache / Hostinger.
# ───────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  # Enforce HTTPS for one year, including subdomains.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Stop browsers from MIME-sniffing a response away from the declared type.
  Header always set X-Content-Type-Options "nosniff"

  # Clickjacking protection — page may only be framed by itself.
  Header always set X-Frame-Options "SAMEORIGIN"

  # Limit referrer leakage to other sites.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Lock down powerful browser features the site does not use.
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"

  # Content-Security-Policy.
  # NOTE: intentionally permissive ('unsafe-inline' for Next.js hydration +
  # framer-motion inline styles, https: for CMS images/fonts). Tighten with a
  # nonce-based policy once a reverse proxy / server runtime is in place.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' https:; connect-src 'self' https:; frame-src 'self' https://www.google.com https://maps.google.com https://www.youtube.com https://www.youtube-nocookie.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self' https:; object-src 'none'; upgrade-insecure-requests"
</IfModule>
